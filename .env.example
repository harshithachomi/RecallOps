# ==========================================
# RecallOps Configuration (.env)
# ==========================================

# Groq LLM API Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Hindsight Persistent Memory Configuration
# Details at https://hindsight.ai
HINDSIGHT_API_URL=https://api.hindsight.ai/v1
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Relational Database URL
# Defaults to local SQLite if omitted: sqlite:///data/recallops.db
# PostgreSQL Example: postgresql://username:password@localhost:5432/recallops_db
DATABASE_URL=sqlite:///data/recallops.db

